# Blackbox 环境变量示例
# 用法:cp .env.example .env.local,改值。.env.local 已 gitignore,不会提交。
# 改完 .env.local 后需清 Metro cache:npx expo start -c(env var 编译时内联)

# Demo 模式:跳过 BLE,用模拟数据喂 context(ADR-0029 Live Activity 开发验证用)
# 1 = 启用(挂载即 streaming,setInterval 喂假数据,不需要车 + 适配器)
# 0 / 不设 = 走真实 BLE(production 默认)
EXPO_PUBLIC_DEMO_MODE=0
